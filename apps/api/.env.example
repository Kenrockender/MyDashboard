FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Single line, newlines escaped as \n (copy from the service account JSON)
FIREBASE_PRIVATE_KEY=""
# "(default)" for standard Firestore, "default" for Enterprise edition
FIREBASE_DATABASE_ID=(default)
# Comma-separated list of origins allowed to call the API (CORS). Set this to
# the deployed web app URL(s) in production. Defaults to http://localhost:3000.
CORS_ORIGINS=http://localhost:3000
# Optional: directory the `npm run backup` script writes Firestore dumps to.
# Defaults to apps/api/backups (gitignored).
BACKUP_DIR=
